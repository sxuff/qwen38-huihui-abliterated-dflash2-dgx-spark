[Unit]
Description=Qwen3.8-27B Huihui-RadixArk abliterated NVFP4-lm_head with DFlash2
After=network-online.target
Wants=network-online.target qwen38-huihui-radixark-dflash2-proxy.service
Before=qwen38-huihui-radixark-dflash2-proxy.service
Conflicts=qwen38-abliterated-dflash2.service qwen38-dflash2.service qwen38-flash-next-q3.service qwen38-aday-vllm.service

[Service]
Type=simple
ExecStart=%h/.local/bin/qwen38-huihui-radixark-dflash2-service.sh
ExecStop=/usr/bin/docker stop -t 45 qwen38-huihui-radixark-nvfp4
TimeoutStartSec=1200
TimeoutStopSec=120
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
